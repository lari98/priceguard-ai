{
  "name": "@priceguard/web",
  "version": "0.1.0",
  "private": true,
  "description": "PriceGuard AI admin dashboard (Next.js) — tenant admin console for risk events, accounts, policy rules, audit log and appeals.",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
