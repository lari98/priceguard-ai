# Copy to .env and fill in real values. Never commit the real .env file.

# --- API (apps/api) ---
NODE_ENV=development
PORT=4000

# Postgres connection used by Prisma
DATABASE_URL="postgresql://geoguard:geoguard_dev_password@localhost:5432/geoguard?schema=public"

# Valkey (Redis-protocol-compatible cache/rate-limit store) — see ADR-0002
VALKEY_URL="redis://localhost:6379"

# JWT signing secret for dashboard sessions — generate with `openssl rand -hex 32`
JWT_SECRET="replace-with-a-random-64-char-hex-string"
JWT_EXPIRES_IN="8h"

# bcrypt cost factor for password/API-key hashing
BCRYPT_SALT_ROUNDS=12

# CORS allowlist for the dashboard origin(s), comma-separated
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# --- Web (apps/web) ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
